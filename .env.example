# ---- General ----
APP_NAME=HindiOCRExcel
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ---- Upload limits ----
MAX_UPLOAD_SIZE_MB=25

# ---- OCR ----
# PaddleOCR recognition language. Use "hi" for Hindi/Devanagari, "en" for English.
OCR_LANG=hi
# Set to true only if a CUDA-capable GPU + GPU paddlepaddle build is installed.
OCR_USE_GPU=false
OCR_USE_ANGLE_CLS=true
OCR_DROP_SCORE=0.30
# Re-recognise numeric cells with a Latin model so ASCII digits (e.g. "99")
# are not misread as Devanagari by the Hindi model. Loads a second, small
# model on demand; set to false on very memory-constrained hosts.
OCR_REFINE_NUMBERS=true
OCR_DIGIT_LANG=en
OCR_DIGIT_MIN_CONF=0.60

# ---- PDF ----
PDF_RENDER_DPI=200
MAX_PDF_PAGES=30

# ---- Processing ----
PROCESSING_TIMEOUT_SEC=600
FILE_RETENTION_MINUTES=120

# ---- CORS (JSON array) ----
CORS_ORIGINS=["*"]
